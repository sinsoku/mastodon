class StatusLengthValidator
  def validate: (Status) -> nil
              | (RSpec::Mocks::InstanceVerifyingDouble) -> nil

  def too_long?: (Status) -> void
               | (RSpec::Mocks::InstanceVerifyingDouble) -> void

  def combined_text: (Status) -> void
                   | (RSpec::Mocks::InstanceVerifyingDouble) -> void

  def countable_text: (String) -> void

  def rewrite_entities: (String, Array[untyped]) -> void

  def countable_length: (String) -> Integer
end
