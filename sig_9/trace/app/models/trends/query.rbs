class Trends::Query
  def initialize: (String, Class) -> void

  def allowed: () -> Trends::Tags::Query
             | () -> Trends::Statuses::Query

  def allowed!: () -> void

  def in_locale: (String) -> Trends::Tags::Query
               | (String) -> Trends::Statuses::Query

  def in_locale!: (String) -> void

  def offset: (Integer) -> Trends::Tags::Query
            | (Integer) -> Trends::Statuses::Query

  def offset!: (Integer) -> void

  def limit: (Integer) -> void
           | (Integer) -> Trends::Statuses::Query

  def limit!: (Integer) -> void

  def each: (*untyped, **untyped) -> Array[untyped]

  def records: () -> Array[untyped]

  def load: () -> void

  def perform_queries: () -> Array[untyped]

  def preferred_languages: () -> void
                         | () -> nil
                         | () -> String

  def size: (*untyped, **untyped) -> Integer

  def to_ary: () -> Array[untyped]

  def filtered_for: (Account) -> Trends::Statuses::Query

  def filtered_for!: (Account) -> void
end
