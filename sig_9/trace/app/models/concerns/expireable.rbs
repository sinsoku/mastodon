class Invite
  def expires_in: () -> nil

  def expired?: () -> bool

  def expires?: () -> void

  def expires_in=: (String) -> String

  def expire!: () -> void
end

class Mute
  def expires_in=: (nil) -> void
end

class Poll
  def expired?: () -> bool

  def expires?: () -> void
end

class CustomFilter
  def expired?: () -> void

  def expires?: () -> void
end
