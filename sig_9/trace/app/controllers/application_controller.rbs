class ApplicationController
  def current_session: () -> SessionActivation
                     | () -> nil

  def check_self_destruct!: () -> nil

  def require_functional!: () -> nil

  def set_cache_control_defaults: () -> Hash[untyped, untyped]

  def current_account: () -> void
                     | () -> nil
                     | () -> Account

  def public_fetch_mode?: () -> void

  def not_found: () -> void
               | () -> ActiveSupport::SafeBuffer
               | () -> String

  def respond_with_error: (Integer) -> void

  def gone: () -> void

  def single_user_mode?: () -> bool

  def current_theme: () -> String

  def skip_csrf_meta_tags?: () -> bool
end

module ApplicationController::HelperMethods
  def current_account: (*untyped, **untyped) -> nil
                     | (*untyped, **untyped) -> Account

  def single_user_mode?: (*untyped, **untyped) -> void

  def current_session: (*untyped, **untyped) -> void
                     | (*untyped, **untyped) -> SessionActivation

  def limited_federation_mode?: (*untyped, **untyped) -> void

  def current_theme: (*untyped, **untyped) -> String

  def skip_csrf_meta_tags?: (*untyped, **untyped) -> void
end
