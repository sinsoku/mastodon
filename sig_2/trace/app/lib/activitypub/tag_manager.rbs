class ActivityPub::TagManager
  def uri_for: (Status) -> void
             | (Account) -> void
             | (Account) -> String
             | (Status) -> String
             | (Follow) -> String
             | (REST::AccountSerializer::AccountDecorator) -> String

  def url_for: (Account) -> void
             | (Status) -> void
             | (REST::AccountSerializer::AccountDecorator) -> void

  def generate_uri_for: (Block) -> void
                      | (Follow) -> void
                      | (FollowRequest) -> void
                      | (Report) -> void

  def uri_to_resource: (String, Class) -> Status
                     | (String, Class) -> Account

  def local_uri?: (String) -> void
                | (String) -> bool

  def key_uri_for: (Account) -> void
                 | (Account) -> String

  def uri_to_actor: (String) -> Account

  def to: (Status) -> void

  def cc: (Status) -> void

  def replies_uri_for: (Status, ?nil) -> void
                     | (Status, ?Hash[untyped, untyped]) -> void

  def likes_uri_for: (Status) -> void

  def shares_uri_for: (Status) -> void
end
