class EmailDomainBlock
  def self.requires_approval?: (Array[untyped], ?attempt_ip: nil) -> void
                             | (Array[untyped], ?attempt_ip: IPAddr) -> void

  def self.block?: (String, ?attempt_ip: nil) -> void
                 | (String, ?attempt_ip: IPAddr) -> void
                 | (Array[untyped], ?attempt_ip: IPAddr) -> void

  def history: () -> Trends::History
end

class EmailDomainBlock::Matcher
  def initialize: (Array[untyped], ?attempt_ip: nil) -> void
                | (String, ?attempt_ip: nil) -> void
                | (Array[untyped], ?attempt_ip: IPAddr) -> void
                | (String, ?attempt_ip: IPAddr) -> void

  def extract_uris: (Array[untyped]) -> Array[untyped]
                  | (String) -> Array[untyped]

  def match?: (*untyped, **untyped) -> void

  def blocking?: (?allow_with_approval: bool) -> void

  def domains_with_variants: () -> void

  def invalid_uri?: () -> void
end
