class CustomFilter
  def irreversible=: (String) -> Symbol

  def context_must_be_valid: () -> nil

  def invalid_context_value?: () -> void

  def prepare_cache_invalidation!: () -> bool

  def invalidate_cache!: () -> Integer
                       | () -> nil

  def irreversible?: () -> void

  def self.cached_filters_for: (Integer) -> Array[untyped]

  def self.apply_cached_filters: (Array[untyped], Status) -> void
                               | (Array[untyped], Status) -> Array[untyped]
end
