class User
  def sanitize_role: () -> nil

  def role: () -> UserRole

  def password_required?: () -> bool

  def external?: () -> void
               | () -> bool

  def invite_text_required?: () -> bool

  def confirmed?: () -> bool

  def validate_email_dns?: () -> bool

  def self.skip_mx_check?: () -> bool

  def validate_role_elevation: () -> nil
                             | () -> ActiveModel::Error

  def set_approved: () -> bool

  def sign_up_from_ip_requires_approval?: () -> void

  def sign_up_email_requires_approval?: () -> void

  def open_registrations?: () -> void

  def send_pending_devise_notifications: () -> Array[untyped]

  def pending_devise_notifications: () -> Array[untyped]

  def trigger_webhooks: () -> String

  def pending?: () -> bool

  def self.those_who_can: (*Symbol) -> ActiveRecord::Relation

  def valid_invitation?: () -> void

  def send_devise_notification: (Symbol, *String | Hash[untyped, untyped], **nil) -> void

  def render_and_send_devise_message: (Symbol, *untyped, **untyped) -> void

  def functional?: () -> bool

  def functional_or_moved?: () -> void

  def activate_session: (ActionDispatch::Request) -> void
                      | (ActionDispatch::Request) -> String

  def active_for_authentication?: () -> bool

  def to_log_human_identifier: () -> void

  def to_log_route_param: () -> void

  def web_push_subscription: (SessionActivation) -> void

  def can?: (*untyped, **untyped) -> void

  def invited?: () -> void

  def two_factor_enabled?: () -> void

  def update_sign_in!: (?new_sign_in: bool) -> void

  def prepare_returning_user!: () -> void

  def needs_feed_update?: () -> void

  def signed_in_recently?: () -> void
end
