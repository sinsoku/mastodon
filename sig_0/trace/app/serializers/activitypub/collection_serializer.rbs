class ActivityPub::CollectionSerializer
  def type: () -> String

  def page?: () -> void

  def ordered?: () -> void
              | () -> bool

  def self.serializer_for: (ActivityPub::CollectionPresenter, Hash[untyped, untyped]) -> Class
                         | (Array[untyped], Hash[untyped, untyped]) -> Class
                         | (String, Hash[untyped, untyped]) -> Class
                         | (Status, Hash[untyped, untyped]) -> Class

  def total_items: () -> Integer
end

class ActivityPub::CollectionSerializer::StringSerializer
  def serializable_hash: (*Hash[untyped, untyped] | Class) -> void
end
