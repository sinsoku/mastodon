class ApplicationPolicy
  def initialize: (Account, TermsOfService) -> void
                | (Account, Symbol) -> void
                | (Account, Account) -> void
                | (Account, Class) -> void
                | (Account, Status) -> void
                | (Account, User) -> void
                | (Account, AccountModerationNote) -> void
                | (Account, Invite) -> void
                | (nil, Status) -> void
                | (Account, AccountWarning) -> void
                | (Account, Tag) -> void

  def role: () -> UserRole

  def current_user: () -> User

  def user_signed_in?: () -> void
end
