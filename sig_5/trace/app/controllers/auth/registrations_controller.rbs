  def set_cache_headers: () -> Hash[untyped, untyped]

  def edit: () -> ActiveSupport::SafeBuffer

  def determine_layout: () -> String

  def set_invite: () -> nil
                | () -> Invite

  def invite_code: () -> void

  def check_enabled_registrations: () -> nil
                                 | () -> String

  def configure_sign_up_params: () -> nil

  def create: () -> String
            | () -> ActiveSupport::SafeBuffer

  def build_resource: (?ActiveSupport::HashWithIndifferentAccess) -> void
