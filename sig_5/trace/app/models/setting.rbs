class Setting
  def self.method_missing: (Symbol, *nil) -> Array[untyped]
                         | (Symbol, *nil) -> bool
                         | (Symbol, *nil) -> String
                         | (Symbol, *nil) -> nil
                         | (Symbol, *String) -> String
                         | (Symbol, *bool) -> bool
                         | (Symbol, *nil) -> Integer

  def self.[]: (String) -> void

  def self.cache_key: (String) -> void

  def self.cache_prefix_by_startup: () -> String

  def self.default_settings: () -> Hash[untyped, untyped]

  def value: () -> void

  def self.[]=: (String, nil) -> void
              | (String, String) -> void
              | (String, bool) -> void

  def value=: (nil) -> void
            | (String) -> void
            | (bool) -> void
            | (Integer) -> String
            | (String) -> String
            | (nil) -> String
            | (bool) -> String

  def rewrite_cache: () -> bool

  def cache_key: () -> void
end
