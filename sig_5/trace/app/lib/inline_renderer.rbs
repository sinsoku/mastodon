class InlineRenderer
  def self.render: (Status, nil, Symbol) -> Hash[untyped, untyped]
                 | (AccountConversation, Account, Symbol) -> Hash[untyped, untyped]

  def initialize: (Status, nil, Symbol) -> void
                | (AccountConversation, Account, Symbol) -> void

  def render: () -> void

  def preload_associations_for_status: () -> void

  def current_user: () -> void
end
