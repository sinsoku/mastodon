class Webfinger
  def initialize: (String) -> void

  def perform: () -> Webfinger::Response

  def standard_url: () -> void

  def body_from_webfinger: (?String, ?bool) -> void

  def webfinger_request: (String) -> Request
end

class Webfinger::Response
  def initialize: (String, String) -> void

  def validate_response!: () -> void

  def subject: () -> String

  def self_link: () -> Hash[untyped, untyped]

  def links: () -> Hash[untyped, untyped]

  def self_link_href: () -> String
end
