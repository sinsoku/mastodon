class InstancePresenter
  def domain: () -> void

  def mascot: () -> nil

  def source_url: () -> void

  def title: () -> void
           | () -> String

  def version: () -> void
             | () -> String

  def favicon: () -> nil

  def app_icon: () -> nil

  def thumbnail: () -> nil

  def user_count: () -> void

  def active_user_count: (?Integer) -> void

  def status_count: () -> void

  def description: () -> void

  def contact: () -> InstancePresenter::ContactPresenter

  def domain_count: () -> void

  def languages: () -> Array[untyped]

  def rules: () -> ActiveRecord::Relation
end

class InstancePresenter::ContactPresenter
  def email: () -> void

  def account: () -> void
end
