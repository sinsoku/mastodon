class ActivityPub::TagManager
  def generate_uri_for: (Follow) -> void
                      | (FollowRequest) -> void
                      | (Report) -> void
                      | (Block) -> void

  def url_for: (Account) -> void
             | (Status) -> void
             | (Status) -> String
             | (Account) -> String
             | (Status) -> nil
             | (Account) -> nil

  def uri_for: (Account) -> void
             | (FollowRequest) -> void
             | (Follow) -> void
             | (Status) -> void
             | (PollVote) -> void

  def key_uri_for: (Account) -> void

  def uri_to_resource: (String, Class) -> void
                     | (String, Class) -> Account
                     | (String, Class) -> nil
                     | (String, Class) -> Status

  def local_uri?: (String) -> void

  def public_collection?: (String) -> void

  def activity_uri_for: (Status) -> void

  def to: (Status) -> void

  def cc: (Status) -> void

  def replies_uri_for: (Status, ?nil) -> void
                     | (Status, ?Hash[untyped, untyped]) -> void

  def likes_uri_for: (Status) -> void

  def shares_uri_for: (Status) -> void

  def uri_to_local_id: (String, ?Symbol) -> void

  def followers_uri_for: (Account) -> void
end
