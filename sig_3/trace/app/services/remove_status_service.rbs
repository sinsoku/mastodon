  def remove_from_mentions: () -> void

  def skip_streaming?: () -> void

  def remove_reblogs: () -> void

  def remove_from_hashtags: () -> void

  def remove_from_public: () -> void

  def remove_from_media: () -> void

  def remove_media: () -> void
end
