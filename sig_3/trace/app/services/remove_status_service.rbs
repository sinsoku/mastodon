class RemoveStatusService
  def call: (Status, **nil) -> void
          | (Status, **bool) -> void

  def remove_from_self: () -> void

  def remove_from_followers: () -> void

  def remove_from_lists: () -> void

  def remove_from_remote_reach: () -> void

  def signed_activity_json: () -> void

  def permanently?: () -> void
