class ApplicationPolicy
  def initialize: (nil, Status) -> void
                | (Account, Symbol) -> void
                | (Account, Poll) -> void
                | (Account, Status) -> void
                | (Account, nil) -> void
                | (Account, Report) -> void
                | (Account, Account) -> void
                | (Account, Class) -> void
                | (Account, Webhook) -> void

  def role: () -> UserRole

  def current_user: () -> User

  def user_signed_in?: () -> void
end
