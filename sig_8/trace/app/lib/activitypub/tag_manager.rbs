class ActivityPub::TagManager
  def generate_uri_for: (FollowRequest) -> void
                      | (Follow) -> void
                      | (Block) -> void
                      | (Report) -> void

  def url_for: (Account) -> void
             | (Status) -> void
             | (Account) -> String
             | (Status) -> String
             | (Status) -> nil
             | (Account) -> nil

  def uri_for: (Account) -> void
             | (FollowRequest) -> void
             | (Status) -> void
             | (Report) -> void

  def key_uri_for: (Account) -> void

  def to: (Status) -> void

  def cc: (Status) -> void

  def replies_uri_for: (Status, ?nil) -> void
                     | (Status, ?Hash[untyped, untyped]) -> void

  def likes_uri_for: (Status) -> void

  def shares_uri_for: (Status) -> void

  def local_uri?: (String) -> void

  def uri_to_resource: (String, Class) -> void
                     | (String, Class) -> Status
                     | (String, Class) -> nil
end
