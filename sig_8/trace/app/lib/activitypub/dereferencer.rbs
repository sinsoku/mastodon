class ActivityPub::Dereferencer
  def initialize: (String, ?permitted_origin: String, ?signature_actor: nil) -> void
                | (String, ?permitted_origin: String, ?signature_actor: Account) -> void

  def object: () -> void

  def fetch_object!: () -> Hash[untyped, untyped]
