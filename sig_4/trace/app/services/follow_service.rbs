class FollowService
  def call: (Account, Account, ?Hash[untyped, untyped]) -> void
          | (Account, Account, ?Hash[untyped, untyped]) -> FollowRequest
          | (Account, Account, ?Hash[untyped, untyped]) -> Follow

  def following_not_possible?: () -> void

  def following_not_allowed?: () -> void

  def request_follow!: () -> void

  def follow_options: () -> Hash[untyped, untyped]

  def build_json: (FollowRequest) -> void

  def change_follow_options!: () -> void
                            | () -> Follow

  def mark_home_feed_as_partial!: () -> void

  def direct_follow!: () -> void
                    | () -> Follow

  def change_follow_request_options!: () -> FollowRequest
end
