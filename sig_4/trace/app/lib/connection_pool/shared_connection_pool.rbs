class ConnectionPool::SharedConnectionPool
  def initialize: (?Hash[untyped, untyped]) -> void

  def with: (String, ?Hash[untyped, untyped]) -> void

  def checkout: (String, ?Hash[untyped, untyped]) -> RequestPool::Connection
              | (String, ?Hash[untyped, untyped]) -> untyped

  def key: (String) -> void

  def key_count: (String) -> void

  def checkin: (String) -> void

  def flush: (*untyped, **untyped) -> Array[untyped]
end
