class UserSettings
  def initialize: (Hash[untyped, untyped]) -> void

  def as_json: () -> void

  def []: (String) -> void
        | (Symbol) -> void

  def []=: (String, bool) -> void
         | (Symbol, bool) -> void
         | (Symbol, String) -> void
         | (Symbol, Symbol) -> void

  def update: (Hash[untyped, untyped]) -> void
end
