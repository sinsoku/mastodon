class SessionActivation
  def self.active?: (nil) -> nil
                  | (String) -> bool

  def self.activate: (**untyped) -> SessionActivation
                   | (**untyped) -> nil

  def assign_access_token: () -> Doorkeeper::AccessToken

  def access_token_attributes: () -> void

  def self.purge_old: () -> void

  def token: (*untyped, **untyped) -> void

  def self.deactivate: (nil) -> void
                     | (String) -> void

  def self.exclusive: (String) -> void
end
