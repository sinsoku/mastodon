module SignatureVerification
  def require_account_signature!: () -> nil
                                | () -> String

  def signed_request_account: () -> void
                            | () -> Account
                            | () -> nil

  def signed_request_actor: () -> void

  def signed_request?: () -> void

  def missing_required_signature_parameters?: () -> void

  def signature_params: () -> Hash[untyped, untyped]

  def signature_algorithm: () -> void
                         | () -> String

  def matches_time_window?: () -> void

  def verify_signature_strength!: () -> void

  def signed_headers: () -> Array[untyped]

  def verify_body_digest!: () -> void

  def actor_from_key_id: (String) -> Account

  def build_signed_string: (?include_query_string: bool) -> String

  def to_header_name: (String) -> void

  def verify_signature: (Account, String, String) -> Account

  def fail_with!: (String, **nil) -> void

  def signature_verification_failure_reason: () -> void

  def signature_verification_failure_code: () -> void
end
