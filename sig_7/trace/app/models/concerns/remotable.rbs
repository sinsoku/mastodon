module Remotable::ClassMethods
  def remotable_attachment: (Symbol, Integer, ?suppress_errors: bool, ?download_on_assign: bool, ?attribute_name: nil) -> void
end

class MediaAttachment
  def remote_url=: (String) -> nil

  def download_file!: (?nil) -> nil

  def download_thumbnail!: (?nil) -> nil
end

class Account
  def avatar_remote_url=: (String) -> nil

  def download_avatar!: (?String) -> nil
                      | (?nil) -> nil

  def header_remote_url=: (String) -> nil

  def download_header!: (?String) -> nil
                      | (?nil) -> nil
end
