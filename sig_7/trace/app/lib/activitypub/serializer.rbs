class ActivityPub::Serializer
  def self.inherited: (Class) -> Hash[untyped, untyped]

  def serializable_hash: (?Hash[untyped, untyped], ?Hash[untyped, untyped], ?Class) -> Hash[untyped, untyped]
                       | (?Hash[untyped, untyped], ?Hash[untyped, untyped], ?ActiveModelSerializers::Adapter::Attributes) -> Hash[untyped, untyped]
end
