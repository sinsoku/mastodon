class Webhook
  def generate_secret: () -> nil
                     | () -> String

  def invalid_events?: () -> bool

  def validate_permissions: () -> nil

  def validate_template: () -> nil

  def required_permissions: () -> Array[untyped]

  def self.permission_for_event: (String) -> void
                               | (String) -> Symbol

  def events_validation_error: () -> ActiveModel::Error

  def disable!: () -> void

  def enable!: () -> void
end
