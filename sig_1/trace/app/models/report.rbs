class Report
  def set_uri: () -> URI::HTTPS
             | () -> nil

  def local?: (*untyped, **untyped) -> bool

  def trigger_create_webhooks: () -> String

  def media_attachments_count: () -> void

  def statuses: () -> ActiveRecord::Relation

