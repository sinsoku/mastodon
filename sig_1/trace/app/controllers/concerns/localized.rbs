module Localized
  def set_locale: () -> nil
                | () -> Symbol
                | () -> String
                | () -> ActiveSupport::SafeBuffer
                | () -> bool
                | () -> Form::AdminSettings
                | () -> ActiveRecord::Relation
                | () -> Webhook
                | () -> Form::AccountBatch
                | () -> Form::TwoFactorConfirmation
