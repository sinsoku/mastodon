class ActivityTracker
  def self.increment: (String) -> void

  def initialize: (String, Symbol) -> void

  def add: (?Integer, ?Time) -> void

  def key_at: (Time) -> String

  def self.record: (String, Integer) -> void

  def sum: (ActiveSupport::TimeWithZone, ?ActiveSupport::TimeWithZone) -> Integer

  def legacy_key_at: (Date) -> void
end
