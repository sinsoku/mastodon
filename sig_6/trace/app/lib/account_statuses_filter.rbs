                | (Account, nil, ?Hash[untyped, untyped]) -> void

  def results: () -> void
             | () -> ActiveRecord::AssociationRelation
             | () -> ActiveRecord::Relation

  def initial_scope: () -> ActiveRecord::AssociationRelation
                   | () -> ActiveRecord::Relation

