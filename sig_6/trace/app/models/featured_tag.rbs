class FeaturedTag
  def validate_tag_uniqueness: () -> nil
                             | () -> ActiveModel::Error

  def tag_already_featured_for_account?: () -> void

  def validate_featured_tags_limit: () -> nil
                                  | () -> ActiveModel::Error

  def set_tag: () -> Tag

  def reset_data: () -> nil
                | () -> ActiveSupport::TimeWithZone

  def visible_tagged_account_statuses: () -> ActiveRecord::AssociationRelation

  def display_name: () -> String

  def sign?: () -> void
           | () -> bool

  def decrement: (Status) -> void

  def increment: (ActiveSupport::TimeWithZone) -> void
end
