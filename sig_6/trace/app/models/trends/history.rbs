class Trends::History
  def initialize: (String, Integer) -> void
                | (String, nil) -> void

  def as_json: (*untyped) -> void

  def each: () -> Array[untyped]

  def get: (ActiveSupport::TimeWithZone) -> void
         | (DateTime) -> Trends::History::Day

  def add: (Integer, ?Time) -> void
         | (Integer, ?DateTime) -> void

  def aggregate: (Range[untyped]) -> Trends::History::Aggregate
end

class Trends::History::Day
  def initialize: (String, Integer, ActiveSupport::TimeWithZone) -> void
                | (String, nil, ActiveSupport::TimeWithZone) -> void
                | (String, Integer, Time) -> void
                | (String, Integer, DateTime) -> void

  def as_json: () -> Hash[untyped, untyped]

  def accounts: () -> Integer

  def key_for: (Symbol) -> void

  def key_prefix: () -> String

  def uses: () -> Integer

  def add: (Integer) -> void
end

class Trends::History::Aggregate
