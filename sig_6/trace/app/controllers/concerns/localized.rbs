module Localized
  def set_locale: () -> String
                | () -> bool
                | () -> nil
                | () -> ActiveSupport::SafeBuffer
                | () -> RQRCode::QRCode
                | () -> Trends::StatusBatch
                | () -> Form::CustomEmojiBatch
                | () -> CustomEmoji
                | () -> Array[untyped]
                | () -> Time
                | () -> FeaturedTag

  def requested_locale: () -> void

  def available_locale_or_nil: (nil) -> nil

  def http_accept_language: () -> nil
                          | () -> String

  def content_locale: () -> void
end
